# Copy to an ignored local environment file only when application configuration
# requires it. Never commit real credentials or secrets.
NEXT_PUBLIC_APP_URL=__REPLACE_WITH_LOCAL_APP_URL__

# Optional: enables the "Email feedback" mailto button in Settings > Feedback.
# Leave unset to only offer "Copy feedback text" (no backend either way).
NEXT_PUBLIC_FEEDBACK_EMAIL=

# --- Checkpoint 2: database + staff admin -----------------------------------
# See docs/checkpoint-2/supabase-setup.md for exact, beginner-friendly steps.

# Safe to expose to the browser (Supabase's own public-key naming).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix a secret with NEXT_PUBLIC_ — anything with that
# prefix is bundled into client-side JavaScript.
SUPABASE_SECRET_KEY=

# Server-only. The application's runtime connection (through Supabase's
# pooler, if used).
DATABASE_URL=
# Server-only. A direct (non-pooled) connection used only for running
# migrations. Falls back to DATABASE_URL if unset.
DATABASE_MIGRATION_URL=

# Server-only. Used exclusively by `npm run db:bootstrap:admin` to identify
# the first administrator account. Never read by any public request path.
BOOTSTRAP_ADMIN_EMAIL=

# Server-only. Base URL the server uses to build absolute links (e.g. in
# Supabase Auth redirects).
APP_BASE_URL=http://localhost:3000

# Feature flags. Both default to the values below; set to "false" to make the
# public site show a safe service-unavailable state instead of the
# database-backed catalogue / staff admin area.
ENABLE_DATABASE_CATALOGUE=true
ENABLE_STAFF_ADMIN=true

# Local-testing convenience ONLY, defaults to disabled. Lets an Administrator
# review/approve their own drafts solo, so one account can walk a record
# through the whole workflow for testing. Separation of duties still applies
# to every other role, and to Administrators when this is unset or "false".
# Never set this to "true" outside a local/dev environment.
ALLOW_ADMIN_SELF_REVIEW=false

# --- Checkpoint 4: discovery, matching, reminders, notifications -----------
# See docs/checkpoint-4/reminders-and-notifications.md.

# Optional, defaults to unset/off. Gates the "enable browser notifications"
# button in the notification center. When unset (or not "true"), that whole
# UI section is hidden and the browser is never asked for permission. Only
# foreground (tab-open) notifications are implemented in this checkpoint —
# see the doc above for why background Web Push is deliberately deferred
# rather than silently missing.
NEXT_PUBLIC_ENABLE_BROWSER_NOTIFICATIONS=false

# Optional, reserved for a future Web Push implementation. NOT currently read
# or used anywhere in the app — documented here only so the variable names
# are settled if/when Web Push is built. VAPID_PRIVATE_KEY must never be
# prefixed with NEXT_PUBLIC_ and must never reach browser JavaScript.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Checkpoint 5: AI assistant ----------------------------------------------
# See docs/checkpoint-5/checkpoint-5-architecture.md and ai-safety-policy.md.
# Every value below defaults to a safe "AI unavailable" state when unset — a
# missing/malformed value here never breaks the build or any non-AI feature.

# Server-only. Off by default. Must be explicitly "true" to turn the
# assistant on at all, in addition to a usable provider being configured
# below. Staff can also pause the assistant instantly at runtime from
# /staff/ai (a separate kill switch from this env var, which only takes
# effect on the next deploy/restart).
AI_ENABLED=false

# Server-only. "mock" is a deterministic, network-free provider — safe in
# any environment (tests, CI, or a real deployment with no AI budget yet) and
# needs no key. "groq" requires GROQ_API_KEY below.
AI_PROVIDER=groq

# Server-only secret. Never prefix with NEXT_PUBLIC_ — the assistant only
# ever calls the configured provider from server-side code, never the
# browser. Leave unset to keep the assistant unavailable (or use
# AI_PROVIDER=mock for a working, non-networked assistant without a key).
GROQ_API_KEY=

# Server-only. Defaults to a small, fast free-tier Groq model if unset.
GROQ_MODEL=llama-3.1-8b-instant

# Server-only. Soft caps on prompt/response size — defaults are conservative
# and rarely need changing.
AI_MAX_INPUT_TOKENS=2000
AI_MAX_OUTPUT_TOKENS=700

# Server-only. Daily question limits, enforced separately for guests (a
# signed cookie, never a growing anonymous-device table) and signed-in
# students (a durable per-account counter). Keeps the assistant usable
# within the project's $100/year free-first budget (see ADR-008) even with a
# paid provider key configured.
AI_DAILY_GUEST_LIMIT=10
AI_DAILY_USER_LIMIT=30

# Server-only. How long safety-event log entries are considered current for
# staff review purposes; does not currently trigger automatic deletion.
AI_LOG_RETENTION_DAYS=30
